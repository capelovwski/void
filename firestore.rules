rules_version = '2';

// Como usar: copie TODO o conteúdo deste arquivo e cole em
// Firebase Console > Firestore Database > Regras (aba "Rules"), substituindo
// o que já estiver lá. Depois clique em "Publicar".
service cloud.firestore {
  match /databases/{database}/documents {

    // Tudo que fica dentro de users/{userId}/... (anotações, transações,
    // tags, bancos, configurações financeiras) só pode ser lido ou escrito
    // pelo dono do caminho (request.auth.uid == userId) — nenhum outro
    // usuário autenticado, mesmo logado, consegue acessar dados de outra
    // pessoa. O {document=**} cobre qualquer subcoleção/documento aninhado,
    // então não é preciso adicionar uma regra nova a cada coleção futura.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Qualquer caminho não listado acima é negado por padrão pelo Firestore,
    // então não é preciso (nem recomendado) adicionar um "allow false" extra.
  }
}
