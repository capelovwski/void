rules_version = '2';

// Como usar: copie TODO o conteúdo deste arquivo e cole em
// Firebase Console > Firestore Database > Regras (aba "Rules"), substituindo
// o que já estiver lá. Depois clique em "Publicar".
service cloud.firestore {
  match /databases/{database}/documents {

    // Anotações ficam em users/{userId}/notes/{noteId}.
    // Só o dono do caminho (request.auth.uid == userId) pode ler ou escrever
    // seus próprios documentos — nenhum outro usuário autenticado, mesmo
    // logado, consegue acessar as anotações de outra pessoa.
    match /users/{userId}/notes/{noteId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Qualquer caminho não listado acima é negado por padrão pelo Firestore,
    // então não é preciso (nem recomendado) adicionar um "allow false" extra.
  }
}
